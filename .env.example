# Pupil's settings. Copy this file to .env and uncomment what you want to change;
# anything left commented keeps its default.

# The agent that writes your lessons: claude or codex. Sign in to Claude Code or Codex
# first. (fake runs without one, for development.)
# PUPIL_AGENT_BACKEND=claude

# The model the agent uses. Empty means Pupil's default: sonnet for Claude,
# gpt-6.1-sol for Codex. Claude takes aliases (sonnet, opus) or full model names.
# PUPIL_MODEL=

# How hard the model thinks: low, medium, high, xhigh or max.
# PUPIL_EFFORT=medium

# Where `pnpm start` serves. Keep the host local: Pupil has no login.
# PUPIL_HOST=127.0.0.1
# PUPIL_PORT=8787

# Where your topics and lessons are kept: by default pupil.db, in a Pupil folder in your
# home folder. Give a full path; ~ isn't expanded.
# PUPIL_DB_PATH=/full/path/to/pupil.db

# PUPIL_LOG_LEVEL=INFO
